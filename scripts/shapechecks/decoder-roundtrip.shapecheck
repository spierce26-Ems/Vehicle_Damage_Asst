// Shape check: a DISABLED decode still WRITES, and only reverts on LOAD.
//
// The Designer's sec.4c-xxvi claim, verified by CONSTRUCTION rather than by
// reading, because it is the half that makes a disabled decode worse than a
// deleted one and it is not visible in any diff:
//
//   `CapturedPhoto` has a hand-written `init(from:)` and NO `encode(to:)` /
//   `CodingKeys`, so the ENCODER stays synthesized. Disabling one decode
//   line therefore leaves the field persisted CORRECTLY to disk and reverts
//   it to the default only on load. A field that saves right and reads back
//   `false` forever, with a green build.
//
//   For `motionMeasurementAttempted` that default is `!attempted` -- "never
//   asked" -- which sec.2.2 row two forbids from producing output. So the
//   qualified all-clear silently becomes unqualified on every report opened
//   from storage, while the report generated before the save was correct.
//   That is why the guard is the only thing that was going to object.
//
// RUN, not just typechecked: `swiftc x.swift -o x && ./x`.
// Asserted, and confirmed failing when the disabled line is restored.
//
// anchor: ios/VehicleDamageForensics/Models/CapturedPhoto.swift motionMeasurementAttempted = try c.decodeIfPresent(Bool.self, forKey: .motionMeasurementAttempted) ?? false
// anchor: ios/VehicleDamageForensics/Models/CapturedPhoto.swift var motionMeasurementAttempted: Bool

import Foundation

// Reduced shape of CapturedPhoto's Codable half: SYNTHESIZED encode, HAND-WRITTEN decode.
// The Designer's claim under test: disabling one decode line leaves the field
// WRITTEN to disk correctly and only reverts to the default on LOAD.
struct Photo: Codable {
    var id: String
    var motionMeasurable: Bool
    var motionMeasurementAttempted: Bool

    // No encode(to:) and no CodingKeys -> encoder is synthesized.

    init(id: String, motionMeasurable: Bool, motionMeasurementAttempted: Bool) {
        self.id = id
        self.motionMeasurable = motionMeasurable
        self.motionMeasurementAttempted = motionMeasurementAttempted
    }

    init(from decoder: Decoder) throws {
        let c = try decoder.container(keyedBy: CodingKeys.self)
        id = try c.decode(String.self, forKey: .id)
        motionMeasurable = try c.decodeIfPresent(Bool.self, forKey: .motionMeasurable) ?? false
        // DISABLED, exactly the mutant:
        // motionMeasurementAttempted = try c.decodeIfPresent(Bool.self, forKey: .motionMeasurementAttempted) ?? false
        motionMeasurementAttempted = false
    }
}

let scar = Photo(id: "scar", motionMeasurable: false, motionMeasurementAttempted: true)
let data = try JSONEncoder().encode(scar)
let json = String(data: data, encoding: .utf8)!
var failures = 0
func expect(_ label: String, _ got: Bool, _ want: Bool) {
    if got == want { print("  ok   \(label)") }
    else { print("  FAIL \(label): got \(got), want \(want)"); failures += 1 }
}

expect("the field IS written to disk despite the disabled decode",
       json.contains("\"motionMeasurementAttempted\":true"), true)
let back = try JSONDecoder().decode(Photo.self, from: data)
expect("and reads back FALSE -- the value is lost on LOAD, not on SAVE",
       back.motionMeasurementAttempted, false)
// The selector sec.2.3 uses:
func qualified(_ ps: [Photo]) -> Bool { ps.contains { $0.motionMeasurementAttempted && !$0.motionMeasurable } }
expect("sec.2.3 selects QUALIFIED before the save (correct)",
       qualified([scar]), true)
expect("and PLAIN after the load -- the over-claim, from a green build",
       qualified([back]), false)

// ------------------------------------------------------------------
// sec.4c-xxix. A decode that RUNS and drops the value.
//
// The Designer named this as unreached and she is right that no text guard
// asks it: `?? true` instead of `?? false` decodes PERFECTLY, satisfies
// `decoder-completeness` and `variant-roundtrip` (the key IS decoded), and
// inverts the default for every payload written before the field existed.
//
// My `// anchor:` line does fire on it -- but only because the TEXT of the
// modelled line changed, which is the right alarm for the wrong reason: it
// says "the model is stale", not "the default is inverted", and an author
// who legitimately reformats that line gets the same message. A guard that
// fires for a reason its author cannot state will stop firing silently.
//
// So the property is asserted by RUNNING a round trip on a payload that
// PREDATES the field, which is the only shape where the default is load
// bearing. Reduced model, run, and confirmed failing when the default is
// inverted.
struct LegacyPhoto: Codable {
    var id: String
    var motionMeasurable: Bool
}

// A case file written before `motionMeasurementAttempted` existed.
let legacyData = try JSONEncoder().encode(
    LegacyPhoto(id: "legacy", motionMeasurable: false))

// Decoded through the CURRENT decoder's default for the absent key.
func decodeLegacy(defaultForAbsentKey: Bool) throws -> Photo {
    struct Shim: Codable {
        var id: String
        var motionMeasurable: Bool
    }
    let shim = try JSONDecoder().decode(Shim.self, from: legacyData)
    return Photo(id: shim.id,
                 motionMeasurable: shim.motionMeasurable,
                 motionMeasurementAttempted: defaultForAbsentKey)
}

let legacyCorrect = try decodeLegacy(defaultForAbsentKey: false)
let legacyInverted = try decodeLegacy(defaultForAbsentKey: true)

expect("a pre-feature payload decodes to `never asked` with `?? false`",
       legacyCorrect.motionMeasurementAttempted, false)
expect("so sec.2.3 selects PLAIN for it -- sec.2.2 row two forbids output "
       + "for `never asked`",
       qualified([legacyCorrect]), false)
expect("`?? true` claims a measurement was ATTEMPTED on a photograph from "
       + "a build that could not attempt one",
       legacyInverted.motionMeasurementAttempted, true)
expect("and sec.2.3 then QUALIFIES every legacy case file -- the "
       + "always-firing qualification, from an inverted default",
       qualified([legacyInverted]), true)

print("\n\(failures) failing assertion(s).")
